# Copie este archivo como .env y cambie los valores. El archivo .env NUNCA se sube a git.
# Valores ficticios solo para el ambiente local (SQL Server exige 8+ caracteres con mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD=Cambiar_Sa_Local_2026!
APP_DB_PASSWORD=Cambiar_App_Local_2026!
CORE_PASSWORD=cambiar-core-local
# client_id de la app móvil para el API Gateway (Kong). Solo letras, números y guiones.
CLIENT_ID_APP_MOVIL=app-movil-local-0001
